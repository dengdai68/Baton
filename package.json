{
  "name": "baton-app",
  "version": "0.1.12",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local AI teams, collaborative tasks and scheduled automation",
  "repository": {
    "type": "git",
    "url": "https://github.com/dengdai68/Baton.git"
  },
  "homepage": "https://github.com/dengdai68/Baton#readme",
  "bugs": {
    "url": "https://github.com/dengdai68/Baton/issues"
  },
  "type": "module",
  "main": "apps/electron/main.mjs",
  "bin": {
    "baton": "cli/main.mjs"
  },
  "scripts": {
    "cli": "node cli/main.mjs",
    "workspace": "node server/workspace-admin.mjs",
    "start": "electron apps/electron/main.mjs",
    "dev": "electron apps/electron/main.mjs",
    "test": "node scripts/run-tests.mjs",
    "check:ai": "node scripts/verify-ai-contract.mjs",
    "check:impact": "node scripts/check-module-impact.mjs",
    "check:commit": "node scripts/check-commit-message.mjs",
    "desktop": "electron apps/electron/main.mjs",
    "desktop:install": "node node_modules/electron/install.js",
    "predesktop:test": "npm run desktop:install",
    "desktop:test": "node scripts/test-electron.mjs",
    "desktop:check": "node --check apps/electron/main.mjs && node --test tests/electron.test.mjs",
    "prepackage:mac": "npm run desktop:install",
    "package:mac": "electron-builder --mac --arm64 --publish never",
    "prepackage:mac:local": "npm run desktop:install",
    "package:mac:local": "node scripts/package-mac-local.mjs",
    "package:mac:check": "node scripts/test-packaged-electron.mjs",
    "mac:check": "npm run desktop:check",
    "mac:run": "npm run desktop"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@antv/x6": "3.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cron-parser": "5.4.0",
    "dompurify": "^3.4.15",
    "electron-updater": "6.8.11",
    "elkjs": "^0.10.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "4.3.2",
    "jsonc-parser": "3.3.1",
    "marked": "^18.0.12",
    "qrcode": "^1.5.4",
    "semver": "7.7.3",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "electron": "44.11.5",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "com.baton.desktop",
    "productName": "Baton",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "LICENSE",
      "NOTICE",
      "apps/electron/**/*",
      "server/**/*",
      "relay/wire.mjs",
      "web/**/*",
      "client/**/*",
      "cli/**/*.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sharp/LICENSE",
        "to": "licenses/sharp/LICENSE"
      },
      {
        "from": "node_modules/@img/sharp-libvips-darwin-arm64/README.md",
        "to": "licenses/sharp-libvips/README.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/electron/LICENSE"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/electron/LICENSES.chromium.html"
      },
      {
        "from": "cli/baton",
        "to": "cli/baton"
      },
      {
        "from": "scripts/migrate-data-home.mjs",
        "to": "scripts/migrate-data-home.mjs"
      }
    ],
    "mac": {
      "icon": "apps/electron/application.icns",
      "category": "public.app-category.business",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "dengdai68",
        "repo": "Baton",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
