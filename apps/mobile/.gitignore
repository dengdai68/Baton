# Repository-wide dependencies, logs and environment files inherit the root rules.

# Expo
/.expo/
/dist/
/web-build/
/expo-env.d.ts

# Native IDE and signing files
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# Package manager diagnostics, including suffixed logs
npm-debug.*
yarn-debug.*
yarn-error.*

# Xcode environment override
.xcode.env.local

# typescript
*.tsbuildinfo

# Expo-generated application projects. Native module source lives under modules/.
/ios/
/android/

# Gradle and native compiler output inside local modules
/modules/*/android/build/
/modules/*/android/.cxx/
/modules/*/android/.gradle/

# UI-test derived data
/tests/e2e/build/

# Locally signed device packages
/build/
